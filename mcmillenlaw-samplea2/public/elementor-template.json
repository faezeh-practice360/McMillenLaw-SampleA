                "typography_font_family": "Inter",
                "typography_font_size": { "unit": "px", "size": "15" },
                "typography_line_height": { "unit": "em", "size": "1.85" }
              }
            },
            {
              "id": "attorney_quote",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<blockquote>\"Behind every allegation is a family, a career, and a lifetime of hard work. Our standard of advocacy manages those responsibilities with ultimate gravity.\"</blockquote>",
                "text_color": "#263044",
                "background_color": "#F7F6F1"
              }
            }
          ]
